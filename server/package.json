{
  "name": "notebooklm-rag-server",
  "version": "1.0.0",
  "description": "RAG backend for Google NotebookLM assignment",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test:embeddings": "node scripts/testEmbeddings.js",
    "test:storage": "node scripts/testStorage.js",
    "test:retrieval": "node scripts/testRetrieval.js",
    "test:chat": "node scripts/testChat.js"
  },
  "dependencies": {
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.80",
    "@langchain/textsplitters": "^0.1.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.4",
    "prettier": "^3.8.3"
  }
}
